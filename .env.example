# Copy this file to ".env" and fill in your keys. Restart `npm run dev` after editing.

# Required. Free key (1,000 requests/day): https://www.omdbapi.com/apikey.aspx
# Gives IMDb, Rotten Tomatoes and Metacritic ratings.
OMDB_API_KEY=

# Optional. Free key from https://api.watchmode.com/ - shows where to watch (streaming/rent/buy).
# Costs 2 credits per title you open. Not blocked by most corporate proxies, unlike TMDB.
WATCHMODE_API_KEY=

# Optional. Free key: https://mdblist.com -> Preferences -> API Access
# Adds extra ratings: TMDB, Trakt, Letterboxd, RT audience, Metacritic user, Roger Ebert...
MDBLIST_API_KEY=
